# AppArmor profile "vice-sandbox" for mesa-sandbox pods (profile R1, ADR-0002).
# Derived from containerd's default container template (contrib/apparmor/template.go)
# with two changes: `mount`/`umount`/`pivot_root` are allowed (containerd's default
# has `deny mount,`) and `userns,` permits unprivileged user namespaces, so
# bubblewrap-based agent sandboxes work inside the pod. Everything the default
# denies to protect the node (/proc/sys, /sys, kernel keyrings, ptrace across
# the boundary) stays denied.
#
# Load on every node: apparmor_parser -r -W /etc/apparmor.d/vice-sandbox
# Use from a pod:  securityContext.appArmorProfile: {type: Localhost, localhostProfile: vice-sandbox}
abi <abi/4.0>,
#include <tunables/global>

profile vice-sandbox flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  mount,
  pivot_root,
  userns,

  signal (send,receive) peer=vice-sandbox,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # suppress ptrace denials when using 'docker ps' or using 'ps' inside a container
  ptrace (trace,read,tracedby,readby) peer=vice-sandbox,
}
